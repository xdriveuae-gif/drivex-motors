    "express": "^4.22.3",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "multer": "^2.5.0",
    "node-sqlite3-wasm": "^0.8.58",
    "nodemailer": "^10.3.1",
